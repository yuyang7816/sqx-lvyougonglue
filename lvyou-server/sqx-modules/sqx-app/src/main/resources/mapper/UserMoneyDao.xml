<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.app.wallet.db.mapper.UserMoneyDao">

    <update id="decr">
        update user_money
        set money = money - #{amount}
        where user_id = #{userId}
    </update>

    <update id="incr">
        update user_money
        set money = money + #{amount}
        where user_id = #{userId}
    </update>
    <select id="selectByUserId" resultType="com.sqx.app.wallet.domain.entity.UserMoney">
        SELECT * FROM `user_money` WHERE user_id = #{userId}
    </select>
</mapper>
